        },
        "type": {
          "const": "certificate"
        },
        "stratum": {
          "enum": [
            "williamson",
            "good",
            "best",
            "kkss",
            "skew-sds",
            "general"
          ]
        },
        "claim": {
          "enum": [
            "empty",
            "partial"
          ]
        },
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "full"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "subgroup_order",
                "include_zero",
                "skew_blocks"
              ],
              "properties": {
                "kind": {
                  "const": "same-subgroup-coset-unions"
                },
                "subgroup_order": {
                  "type": "integer",
                  "minimum": 1
                },
                "include_zero": {
                  "type": "boolean"
                },
                "skew_blocks": {
                  "const": 1
                }
              }
            }
          ]
        },
        "method": {
          "enum": [
            "literature",
            "row-sum-theorem",
            "coset-row-sum-theorem",
            "good-coverage-v1",
            "archived-good-coverage-v1",
            "best-coverage-v1"
          ]
        },
        "records": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^evidence/[A-Za-z0-9_./-]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "snapshot_commit",
            "binding",
            "artifact"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "snapshot_commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "binding": {
              "enum": [
                "archived-with-receipt",
                "replayed"
              ]
            },
            "artifact": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^evidence/[A-Za-z0-9_./-]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "required": [
        "schema_version",
        "id",
        "n",
        "group",
        "submitted_by",
        "submitted_at",
        "discovered_by",
        "sources",
        "type",
        "stratum",
        "claim",
        "scope",
        "method",
        "records",
        "gaps"
      ]
    },
